<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>latest</LangVersion><DefineConstants>$(DefineConstants);SOLOSTONE_TEST_HOOKS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(Installer)' != 'false'"><DefineConstants>$(DefineConstants);SOLOSTONE_INSTALLER</DefineConstants></PropertyGroup>
  <Import Project="../BuildInputs.targets" />
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.6.2]" />
    <Content Include="../SoloStone.Launcher/*.cs" Link="launcher-source/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../SoloStone.Launcher/Gui/*.cs" Link="launcher-source/Gui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../SoloStone.Launcher/SoloStone.Launcher.csproj" Link="launcher-source/SoloStone.Launcher.csproj" CopyToOutputDirectory="PreserveNewest" />
