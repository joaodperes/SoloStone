    <Content Include="../build.ps1" Link="launcher-source/build.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/InstallerRuntime.cs" Link="launcher-source/InstallerRuntime.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/OfflineProbe.csproj" Link="launcher-source/OfflineProbe.csproj" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/**" Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(TestedClientFile)" LogicalName="tested-client.json" />
    <Content Include="../../plugin/OfflineProbe.cs" Link="plugin-source/OfflineProbe.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/OfflineGuard.cs" Link="plugin-source/OfflineGuard.cs" CopyToOutputDirectory="PreserveNewest" />
