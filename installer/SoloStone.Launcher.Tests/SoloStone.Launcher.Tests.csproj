    <Content Include="../../plugin/client-bindings.txt" Link="plugin-source/client-bindings.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/ClientBridge.cs" Link="plugin-source/ClientBridge.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/SelectedProfile.cs" Link="plugin-source/SelectedProfile.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/LocalProfile.cs" Link="plugin-source/LocalProfile.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/NativeGuideCards.cs" Link="plugin-source/NativeGuideCards.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/NativePlaytest.cs" Link="plugin-source/NativePlaytest.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/NativeTestControl.cs" Link="plugin-source/NativeTestControl.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../plugin/TestControlProtocol.cs" Link="plugin-source/TestControlProtocol.cs" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../SoloStone.Launcher/Core.cs" Link="Core.cs" />
    <Compile Include="../SoloStone.Launcher/Options.cs" Link="Options.cs" />
    <Compile Include="../SoloStone.Launcher/LabGuard.cs" Link="LabGuard.cs" />
    <Compile Include="../SoloStone.Launcher/CoreLauncher.cs" Link="CoreLauncher.cs" />
    <Compile Include="../SoloStone.Launcher/WindowsFirewall.cs" Link="WindowsFirewall.cs" />
    <Compile Include="../SoloStone.Launcher/RuntimeProtection.cs" Link="RuntimeProtection.cs" />
    <Compile Include="../SoloStone.Launcher/Fs.cs" Link="Fs.cs" />
    <Compile Include="../SoloStone.Launcher/Install.cs" Link="Install.cs" />
    <Compile Include="../SoloStone.Launcher/ClientPolicy.cs" Link="ClientPolicy.cs" />
    <Compile Include="../SoloStone.Launcher/Minisign.cs" Link="Minisign.cs" />
    <Compile Include="../SoloStone.Launcher/ReleaseManifest.cs" Link="ReleaseManifest.cs" />
    <Compile Include="../SoloStone.Launcher/UpdateClient.cs" Link="UpdateClient.cs" />
    <Compile Include="../SoloStone.Launcher/UpdateEngine.cs" Link="UpdateEngine.cs" />
    <Compile Include="../SoloStone.Launcher/LaunchGate.cs" Link="LaunchGate.cs" />
    <Compile Include="../SoloStone.Launcher/ClientIdentity.cs" Link="ClientIdentity.cs" />
    <!-- Window logic without any WinForms: wording, wizard and launcher models, and the pure part of the live-test hooks. -->
    <Compile Include="../SoloStone.Launcher/Gui/Texts.cs" Link="Gui/Texts.cs" />
    <Compile Include="../SoloStone.Launcher/Gui/Messages.cs" Link="Gui/Messages.cs" />
    <Compile Include="../SoloStone.Launcher/Gui/WizardModel.cs" Link="Gui/WizardModel.cs" />
    <Compile Include="../SoloStone.Launcher/Gui/LauncherModel.cs" Link="Gui/LauncherModel.cs" />
    <Compile Include="../SoloStone.Launcher/Gui/TestHooksCore.cs" Link="Gui/TestHooksCore.cs" />
    <Compile Include="../../plugin/InstallerRuntime.cs" Link="InstallerRuntime.cs" />
    <Compile Include="../../plugin/OfflineGuard.cs" Link="OfflineGuard.cs" />
    <Compile Include="../../plugin/ClientBindings.cs" Link="ClientBindings.cs" />
    <Compile Include="../../plugin/ProfileCatalog.cs" Link="ProfileCatalog.cs" />
